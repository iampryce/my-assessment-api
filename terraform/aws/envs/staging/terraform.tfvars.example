# Copy this file to terraform.tfvars and adjust if needed.
# terraform.tfvars is gitignored and must never be committed with real
# account details. No credentials belong in this file at all — RDS's
# master password is managed entirely by AWS Secrets Manager (see
# terraform/aws/modules/rds/main.tf).

aws_region = "us-east-1"
azs        = ["us-east-1a", "us-east-1b"]

vpc_cidr = "10.30.0.0/16"

kubernetes_version = "1.31"

node_instance_type = "t3.medium"
node_desired_size  = 2
node_min_size      = 1
node_max_size      = 3

rds_engine_version    = "16"
rds_instance_class    = "db.t3.micro"
rds_allocated_storage = 20

rds_multi_az                = false
rds_backup_retention_period = 1

# Standing personal cluster access moved to its own isolated Terraform state -
# see admin-access/terraform.tfvars.example. It no longer lives in this root
# because this root is fully reconciled by CI (eks-core.yml), which would
# silently delete a personal-only entry it has no config for.
